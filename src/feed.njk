---
permalink: /feed.xml
excludeFromSitemap: true
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.name }}</title>
  <subtitle>{{ site.tagline }}</subtitle>
  <id>{{ site.url }}</id>
  <link href="{{ site.url }}"/>
  <link href="{{ '/feed.xml' | absoluteUrl(site.url) }}" rel="self" type="application/atom+xml"/>
  <updated>{% if collections.posts.length %}{{ collections.posts[0].date | isoDate }}{% else %}{{ buildYear }}-01-01T00:00:00.000Z{% endif %}</updated>
  <author><name>{{ site.author }}</name></author>
  {% for post in collections.posts %}
  <entry>
    <title>{{ post.data.title }}</title>
    <id>{{ post.url | absoluteUrl(site.url) }}</id>
    <link href="{{ post.url | absoluteUrl(site.url) }}"/>
    <updated>{{ post.date | isoDate }}</updated>
    <published>{{ post.date | isoDate }}</published>
    {% if post.data.description %}<summary>{{ post.data.description }}</summary>{% endif %}
    {% if post.data.featuredImage %}<link rel="enclosure" href="{{ post.data.featuredImage | absoluteUrl(site.url) }}" type="image/*"/>{% endif %}
  </entry>
  {% endfor %}
</feed>
