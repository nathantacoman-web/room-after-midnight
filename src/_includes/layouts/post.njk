---
layout: layouts/base.njk
---
<main id="main-content" class="site-shell">
  <article>
    <header class="article-header">
      <div class="post-labels">
        <span class="post-category">{{ category or "Notes" }}</span>
        {% if movieYear %}<span class="post-note">{{ movieYear }}</span>{% endif %}
        {% if projectStatus %}<span class="post-note">{{ projectStatus }}</span>{% endif %}
        {% if placeholder %}<span class="post-note">Sample post</span>{% endif %}
      </div>
      <h1>{{ title }}</h1>
      {% if description %}<p class="article-deck">{{ description }}</p>{% endif %}
      <time class="article-date" datetime="{{ date | htmlDate }}">{{ date | shortDate }}</time>
    </header>

    {% if heroImage or featuredImage %}
      <figure class="article-hero">
        <div class="article-hero-media">
          <img src="{{ heroImage or featuredImage }}" alt="{{ heroAlt or featuredImageAlt or '' }}" loading="eager" decoding="async">
        </div>
        {% if heroImageCaption or featuredImageCaption %}<figcaption>{{ heroImageCaption or featuredImageCaption }}</figcaption>{% endif %}
      </figure>
    {% endif %}

    <div class="article-body">
      {{ content | safe }}
    </div>
  </article>

  <div class="article-footer">
    <a class="back-link" href="/archive/">← Back to the archive</a>
  </div>
</main>
