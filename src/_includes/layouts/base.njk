<!doctype html>
<html lang="en">
<head>
  {% set pageDescription = description or site.description %}
  {% set documentTitle = site.name %}
  {% if pageKey != "home" %}{% set documentTitle = title + " — " + site.name %}{% endif %}
  {% set socialImageUrl = featuredImage or site.socialImage %}
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ pageDescription }}">
  <meta name="theme-color" content="#f2ecdd">
  {% if noindex %}<meta name="robots" content="noindex, follow">{% endif %}
  <title>{{ documentTitle }}</title>
  <link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}">
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }} feed" href="{{ '/feed.xml' | absoluteUrl(site.url) }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:type" content="{% if pageType == 'article' %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ documentTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}">
  {% if socialImageUrl %}<meta property="og:image" content="{{ socialImageUrl | absoluteUrl(site.url) }}">{% endif %}
  {% if pageType == "article" and date %}
    <meta property="article:published_time" content="{{ date | isoDate }}">
    {% if category %}<meta property="article:section" content="{{ category }}">{% endif %}
  {% endif %}
  <meta name="twitter:card" content="{% if socialImageUrl %}summary_large_image{% else %}summary{% endif %}">
  <meta name="twitter:title" content="{{ documentTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  {% if socialImageUrl %}<meta name="twitter:image" content="{{ socialImageUrl | absoluteUrl(site.url) }}">{% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Libre+Franklin:wght@400;500;600;700&family=Source+Serif+4:ital,wght@0,400;0,600;0,700;1,400&family=Caveat:wght@600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
  <script src="/script.js" defer></script>
</head>
<body data-page="{{ pageKey }}">
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header">
    <div class="site-shell">
      <div class="utility-bar">
        <span>VISIONS AND DREAMS COME TO LIFE</span>
        <a href="/feed.xml">The feed ↗</a>
      </div>
      <div class="header-inner">
        <a class="masthead" href="/" aria-label="{{ site.name }}"><span>Driveway</span> <span>Avenue</span><span class="masthead-dot" aria-hidden="true">.</span></a>
        <p class="publication-note">“Cinema is the most beautiful fraud in the world.”<span class="publication-attribution">— Jean-Luc Godard</span></p>
      </div>
      <nav class="site-nav" aria-label="Primary navigation">
        <ul>
          {% for item in site.navigation %}
            <li><a href="{{ item.url }}"{% if item.key == pageKey %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endfor %}
        </ul>
        <a class="nav-subscribe" href="{% if pageKey == 'home' %}#newsletter-title{% else %}/#newsletter-title{% endif %}">Letters by email ↓</a>
      </nav>
    </div>
  </header>

  {{ content | safe }}

  <footer class="site-footer">
    <div class="site-shell">
      <div class="footer-top">
        <a class="footer-brand" href="/">Driveway<br>Avenue<span aria-hidden="true">.</span></a>
        <p>Movies, thoughts, projects,<br>and more.</p>
        <nav aria-label="Footer navigation"><a href="/about/">About the publication ↗</a><a href="/archive/">All the writing ↗</a><a href="/feed.xml">Atom feed ↗</a></nav>
      </div>
      <div class="footer-inner"><span>© {{ buildYear }} {{ site.name }}</span><span>Written and made by {{ site.author }}.</span><span>drivewayavenue.com</span></div>
    </div>
  </footer>
</body>
</html>
