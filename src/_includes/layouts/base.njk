<!doctype html>
<html lang="en">
<head>
  {% set pageDescription = description or site.description %}
  {% set documentTitle = site.name %}
  {% if pageKey != "home" %}{% set documentTitle = title + " — " + site.name %}{% endif %}
  {% set socialImageUrl = featuredImage or site.socialImage %}
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ pageDescription }}">
  <meta name="theme-color" content="#171816">
  {% if noindex %}<meta name="robots" content="noindex, follow">{% endif %}
  <title>{{ documentTitle }}</title>
  <link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}">
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }} feed" href="{{ '/feed.xml' | absoluteUrl(site.url) }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:type" content="{% if pageType == 'article' %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ documentTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}">
  {% if socialImageUrl %}<meta property="og:image" content="{{ socialImageUrl | absoluteUrl(site.url) }}">{% endif %}
  {% if pageType == "article" and date %}
    <meta property="article:published_time" content="{{ date | isoDate }}">
    {% if category %}<meta property="article:section" content="{{ category }}">{% endif %}
  {% endif %}
  <meta name="twitter:card" content="{% if socialImageUrl %}summary_large_image{% else %}summary{% endif %}">
  <meta name="twitter:title" content="{{ documentTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  {% if socialImageUrl %}<meta name="twitter:image" content="{{ socialImageUrl | absoluteUrl(site.url) }}">{% endif %}
  <link rel="stylesheet" href="/style.css">
  <script src="/script.js" defer></script>
  <!-- MailerLite Universal -->
  <script>
    (function(w,d,e,u,f,l,n){w[f]=w[f]||function(){(w[f].q=w[f].q||[])
    .push(arguments);},l=d.createElement(e),l.async=1,l.src=u,
    n=d.getElementsByTagName(e)[0],n.parentNode.insertBefore(l,n);})
    (window,document,'script','https://assets.mailerlite.com/js/universal.js','ml');
    ml('account', '2604337');
  </script>
  <!-- End MailerLite Universal -->
</head>
<body data-page="{{ pageKey }}">
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header">
    <div class="site-shell header-inner">
      <a class="masthead" href="/">{{ site.name }}</a>
      <nav class="site-nav" aria-label="Primary navigation">
        <ul>
          {% for item in site.navigation %}
            <li>
              <a href="{{ item.url }}"{% if item.key == pageKey %} aria-current="page"{% endif %}>{{ item.label }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    </div>
  </header>

  {{ content | safe }}

  <footer class="site-footer">
    <div class="site-shell footer-inner">
      <span>© {{ buildYear }} {{ site.name }}</span>
      <span>Written and made by {{ site.author }}.</span>
    </div>
  </footer>
</body>
</html>
