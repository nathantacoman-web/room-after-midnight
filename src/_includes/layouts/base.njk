<!doctype html>
<html lang="en">
<head>
  {% set pageDescription = description or site.description %}
  {% set documentTitle = site.name %}
  {% if pageKey != "home" %}{% set documentTitle = title + " — " + site.name %}{% endif %}
  {% set socialImageUrl = featuredImage or site.socialImage %}
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ pageDescription }}">
  <meta name="theme-color" content="#171816">
  {% if noindex %}<meta name="robots" content="noindex, follow">{% endif %}
  <title>{{ documentTitle }}</title>
  <link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}">
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }} feed" href="{{ '/feed.xml' | absoluteUrl(site.url) }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:type" content="{% if pageType == 'article' %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ documentTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}">
  {% if socialImageUrl %}<meta property="og:image" content="{{ socialImageUrl | absoluteUrl(site.url) }}">{% endif %}
  {% if pageType == "article" and date %}
    <meta property="article:published_time" content="{{ date | isoDate }}">
    {% if category %}<meta property="article:section" content="{{ category }}">{% endif %}
  {% endif %}
  <meta name="twitter:card" content="{% if socialImageUrl %}summary_large_image{% else %}summary{% endif %}">
  <meta name="twitter:title" content="{{ documentTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  {% if socialImageUrl %}<meta name="twitter:image" content="{{ socialImageUrl | absoluteUrl(site.url) }}">{% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Serif+Text:ital@0;1&family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
  <script src="/script.js" defer></script>
</head>
<body data-page="{{ pageKey }}">
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header">
    <div class="site-shell header-inner">
      <a class="masthead" href="/" aria-label="{{ site.name }}">
        <span>Room</span>
        <span>After</span>
        <span>Midnight</span>
        {% if pageKey == "home" %}
          <svg class="masthead-streetlight" viewBox="0 0 64 70" aria-hidden="true" focusable="false">
            <path d="M8 68V17C8 10.4 13.4 5 20 5h32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke" />
            <path d="M48.5 0.5H64l-3.25 11h-9L48.5 6z" fill="currentColor" />
          </svg>
        {% endif %}
      </a>
      <nav class="site-nav" aria-label="Primary navigation">
        <ul>
          {% for item in site.navigation %}
            <li>
              <a href="{{ item.url }}"{% if item.key == pageKey %} aria-current="page"{% endif %}>{{ item.label }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    </div>
  </header>

  {{ content | safe }}

  <footer class="site-footer">
    <div class="site-shell footer-inner">
      <span>© {{ buildYear }} {{ site.name }}</span>
      <span>Written and made by {{ site.author }}.</span>
    </div>
  </footer>
</body>
</html>
