{% macro render(items) %}
  {% if items.length %}
  <ol class="post-list">
    {% for post in items %}
      <li class="post-preview{% if post.data.thumbnail %} post-preview--with-image{% endif %}">
        <div class="post-meta">
          <span class="post-number" aria-hidden="true">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>
          <div class="post-labels">
            <span class="post-category">{{ post.data.category or "Notes" }}</span>
          </div>
          <time datetime="{{ post.date | htmlDate }}">{{ post.date | shortDate }}</time>
        </div>
        {% if post.data.thumbnail %}
          <a class="post-preview-media" href="{{ post.url }}" tabindex="-1" aria-hidden="true">
            <img src="{{ post.data.thumbnail }}" alt="{{ post.data.thumbnailAlt or post.data.heroAlt or '' }}" loading="lazy" decoding="async">
          </a>
        {% endif %}
        <div class="post-preview-content">
          <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
          {% if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}
        </div>
      </li>
    {% endfor %}
  </ol>
  {% endif %}
{% endmacro %}
