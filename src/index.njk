---
layout: layouts/base.njk
title: Home
pageKey: home
permalink: /
---
{% from "components/post-list.njk" import render as postList %}
<main id="main-content">
  <section class="homepage-hero" aria-labelledby="home-title">
    <img src="/assets/images/room-after-midnight-hero.jpg" alt="Out-of-focus city lights glowing beneath a blue and pink evening sky." width="2700" height="1800" fetchpriority="high">
    <div class="site-shell homepage-hero-inner">
      <div class="intro">
        <span class="intro-mark" aria-hidden="true"></span>
        <h1 id="home-title">Movies, thoughts, projects,<br class="intro-desktop-break"> and more.</h1>
      </div>
    </div>
  </section>

  <div class="site-shell homepage-content">
    <section class="latest-section" aria-labelledby="latest-title">
      <div class="section-heading">
        <h2 id="latest-title">Latest</h2>
        <a href="/archive/">View the archive →</a>
      </div>
      {{ postList(collections.posts | limit(5)) }}
    </section>

    <section class="tonights-stack" aria-labelledby="tonights-stack-title">
      <div class="section-heading">
        <h2 id="tonights-stack-title">Tonight’s Stack</h2>
      </div>
      <ol class="stack-list">
        <li class="stack-entry">
          <span class="eyebrow">Movie</span>
          <h3>Dredd</h3>
          <p>Gritty, brutal sci-fi action.</p>
        </li>
        <li class="stack-entry">
          <span class="eyebrow">Movie</span>
          <h3>Superbad</h3>
          <p>One of the great hangout comedies.</p>
        </li>
        <li class="stack-entry">
          <span class="eyebrow">Movie</span>
          <h3>Everybody Wants Some!!</h3>
          <p>Pure good-time hangout energy.</p>
        </li>
      </ol>
    </section>

    <section class="newsletter" aria-labelledby="newsletter-title">
      <div>
        <h2 id="newsletter-title">Get new stuff by email.</h2>
        <p>Occasional notes. No schedule, no noise.</p>
      </div>
      <div class="beehiiv-embed">
        <script async src="https://subscribe-forms.beehiiv.com/v3/loader.js" data-beehiiv-form="2b1cfe30-29a4-4ff8-a401-2edf53bcb5a5"></script>
      </div>
    </section>
  </div>
</main>
