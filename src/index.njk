---
layout: layouts/base.njk
title: Home
pageKey: home
permalink: /
---
{% from "components/post-list.njk" import render as postList %}
<main id="main-content" class="site-shell homepage">
  <h1 class="visually-hidden">Driveway Avenue — movies, thoughts, projects, and more.</h1>
  {% set featured = collections.featuredPosts[0] %}
  {% if featured %}
  {% set featureImage = featured.data.featuredImage or featured.data.heroImage %}
  <section class="front-page{% if not featureImage %} front-page--text-only{% endif %}" aria-labelledby="featured-title">
    <div class="feature-copy">
      <p class="eyebrow"><span class="ink-square" aria-hidden="true"></span> In the spotlight / {{ featured.data.category or "Notes" }}</p>
      <h2 id="featured-title"><a href="{{ featured.url }}">{{ featured.data.title }}</a></h2>
      {% if featured.data.description %}<p class="feature-deck">{{ featured.data.description }}</p>{% endif %}
      <div class="feature-byline"><span>By {{ site.author }}</span><time datetime="{{ featured.date | htmlDate }}">{{ featured.date | shortDate }}</time></div>
      <a class="read-story" href="{{ featured.url }}">Read the story <span aria-hidden="true">↗</span></a>
      <span class="margin-note" aria-hidden="true">Worth a closer look.</span>
    </div>
    {% if featureImage %}
    <figure class="contact-sheet">
      <div class="film-edge" aria-hidden="true"><span>DA / FIELD OF VIEW</span><span>01</span></div>
      <div class="contact-image"><img src="{{ featureImage }}" alt="{{ featured.data.featuredImageAlt or featured.data.heroAlt }}" fetchpriority="high"><span class="frame-marker" aria-hidden="true">01</span></div>
      {% if featured.data.featuredImageCaption or featured.data.heroImageCaption %}<figcaption>{{ featured.data.featuredImageCaption or featured.data.heroImageCaption }}</figcaption>{% endif %}
    </figure>
    {% endif %}
  </section>
  {% endif %}

  {% if collections.moviePosts.length %}
  <section class="latest-section" aria-labelledby="latest-title">
    <div class="section-heading"><h2 id="latest-title">Fresh off the press</h2><a href="/archive/">The whole archive ↗</a></div>
    {{ postList(collections.moviePosts | limit(5)) }}
  </section>
  {% endif %}

  {% if recommendations.length %}
  <div class="editorial-lower editorial-lower--stack-only">
    <section class="tonights-stack" aria-labelledby="tonights-stack-title">
      <div class="section-heading"><h2 id="tonights-stack-title">Tonight’s Stack</h2><span class="eyebrow">Queue these up</span></div>
      <ol class="stack-list">
        {% for recommendation in recommendations %}
        <li class="stack-entry"><span class="eyebrow">{% if loop.index < 10 %}0{% endif %}{{ loop.index }} / Movie</span><h3>{{ recommendation.title }}</h3><p>{{ recommendation.description }}{% if recommendation.quote %}<span class="stack-quote">{{ recommendation.quote }}</span>{% endif %}</p></li>
        {% endfor %}
      </ol>
      {% if collections.moviePosts.length %}<a class="text-link" href="/movies/">More from the movie notebook ↗</a>{% endif %}
    </section>
  </div>
  {% endif %}

  <section class="newsletter" aria-labelledby="newsletter-title">
    <div class="newsletter-copy"><p class="eyebrow">The Driveway Avenue letters</p><h2 id="newsletter-title">Good stuff.<br>No algorithm.</h2><p>Overlooked movies, indie discoveries, occasional writing, and films worth finding. Sent occasionally.</p></div>
    <div class="newsletter-form"><span class="mail-note" aria-hidden="true">Straight to your inbox ↘</span><div class="beehiiv-embed"><script async src="https://subscribe-forms.beehiiv.com/v3/loader.js" data-beehiiv-form="2b1cfe30-29a4-4ff8-a401-2edf53bcb5a5"></script></div><p class="newsletter-fallback">Prefer a reader? <a href="/feed.xml">Follow the Atom feed ↗</a></p></div>
  </section>
</main>
