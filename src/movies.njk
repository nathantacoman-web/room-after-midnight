---
layout: layouts/base.njk
title: Movies
pageKey: movies
permalink: /movies/
description: Movies watched and writing about film.
---
{% from "components/post-list.njk" import render as postList %}
<main id="main-content" class="site-shell content-page">
  <header class="page-heading">
    <h1>Movies</h1>
    <p>Movies I've watched, loved, hated, or felt like talking about.</p>
  </header>

  {% if collections.moviePosts.length %}
  <section class="feature-section" aria-labelledby="movie-writing-title">
    <div class="section-heading">
      <h2 id="movie-writing-title">Movie Writing</h2>
    </div>
    {{ postList(collections.moviePosts) }}
  </section>
  {% endif %}
</main>
